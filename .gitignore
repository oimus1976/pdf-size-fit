# Keep real/private PDFs out of source control by default.
*.pdf

# Synthetic, redistributable fixtures may be explicitly kept here.
!tests/fixtures/*.pdf

# Keep raw local verification/build logs out of source control.
logs/verification/*.log

.venv/
venv/
.stage2-build/
.stage2-sources/
.portable-build-venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
fixtures-generated/
tmp/
